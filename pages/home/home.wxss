.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  background:
    radial-gradient(circle at 50% 120rpx, rgba(198, 151, 75, 0.16), rgba(198, 151, 75, 0) 280rpx),
    linear-gradient(180deg, #070705 0%, #0d0b08 52%, #050504 100%);
  color: #ead7ae;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 36rpx;
}

.hero-logo {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 35% 25%, rgba(218, 165, 86, 0.72), rgba(139, 80, 33, 0.44) 44%, rgba(38, 22, 12, 0.98) 100%),
    linear-gradient(145deg, #7c3d1b, #1a120d);
  border: 2rpx solid rgba(205, 151, 73, 0.58);
  color: #e7c581;
  font-size: 50rpx;
  font-weight: 700;
  box-shadow:
    0 0 24rpx rgba(190, 126, 49, 0.22),
    inset 0 0 16rpx rgba(221, 166, 86, 0.18);
}

.hero-title {
  margin-top: 20rpx;
  color: #efd7a4;
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 10rpx;
  text-indent: 10rpx;
}

.hero-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.divider-line {
  width: 92rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(184, 139, 73, 0), rgba(184, 139, 73, 0.82));
}

.divider-line:last-child {
  background: linear-gradient(90deg, rgba(184, 139, 73, 0.82), rgba(184, 139, 73, 0));
}

.divider-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d6a658;
}

.hero-subtitle {
  margin-top: 16rpx;
  color: rgba(232, 211, 171, 0.62);
  font-size: 26rpx;
}

.mode-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.mode-card {
  position: relative;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(12, 12, 9, 0.96);
  border: 1rpx solid rgba(199, 154, 87, 0.42);
  box-shadow:
    0 18rpx 36rpx rgba(0, 0, 0, 0.36),
    inset 0 0 0 1rpx rgba(255, 232, 169, 0.04);
}

.mode-card-hover {
  background: rgba(28, 24, 16, 0.98);
}

.mode-kicker {
  color: rgba(232, 211, 171, 0.62);
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.mode-title {
  margin-top: 10rpx;
  color: #efd7a4;
  font-size: 40rpx;
  font-weight: 700;
}

.mode-desc {
  margin-top: 16rpx;
  padding-right: 96rpx;
  color: #e8d3ab;
  font-size: 27rpx;
  line-height: 42rpx;
}

.mode-action {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #f6d27e 0%, #c98936 100%);
  color: #201005;
  font-size: 26rpx;
  font-weight: 700;
}

.zuma-card {
  border-color: rgba(214, 166, 88, 0.6);
  background:
    radial-gradient(circle at 90% 20%, rgba(214, 166, 88, 0.12), transparent 180rpx),
    rgba(14, 13, 10, 0.96);
}

.zuma-action {
  background: linear-gradient(180deg, #ffd980 0%, #d48b2d 100%);
}

.cutrope-card {
  border-color: rgba(125, 181, 50, 0.55);
  background:
    radial-gradient(circle at 90% 20%, rgba(125, 181, 50, 0.14), transparent 180rpx),
    rgba(14, 13, 10, 0.96);
}

.cutrope-action {
  background: linear-gradient(180deg, #9fd84a 0%, #5a8f24 100%);
  color: #142008;
}

.kr-card {
  border-color: rgba(231, 189, 119, 0.55);
  background:
    radial-gradient(circle at 90% 20%, rgba(36, 70, 56, 0.35), transparent 180rpx),
    rgba(14, 13, 10, 0.96);
}

.kr-action {
  background: linear-gradient(180deg, #e7bd77 0%, #8d6a32 100%);
  color: #1c2418;
}
