.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #070705;
  color: #ead7ae;
}

.charts { padding: 20rpx 24rpx 0; }

.chart-card {
  margin-bottom: 16rpx;
  padding: 18rpx 18rpx 8rpx;
  border-radius: 20rpx;
  background: rgba(16, 14, 10, 0.94);
  border: 1rpx solid rgba(199, 154, 87, 0.28);
}

.chart-title {
  color: #efd7a4;
  font-size: 28rpx;
  font-weight: 700;
}

.chart {
  width: 100%;
  height: 280rpx;
}

.chart.short { height: 220rpx; }

.chart-foot,
.empty,
.match-time {
  color: rgba(232, 211, 171, 0.62);
  font-size: 24rpx;
}

.chart-foot { padding: 0 8rpx 12rpx; }

.list-title {
  margin: 12rpx 32rpx;
  color: #efd7a4;
  font-size: 28rpx;
  font-weight: 700;
}

.empty { margin: 12rpx 32rpx 24rpx; }

.match {
  margin: 0 24rpx 12rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 18rpx;
  background: rgba(16, 14, 10, 0.94);
  border: 1rpx solid rgba(199, 154, 87, 0.2);
}

.match-code { color: #efd7a4; font-size: 28rpx; }
.match-time { margin-top: 6rpx; }
.match-score { font-size: 30rpx; font-weight: 700; }
.match-score.win { color: #e25b4b; }
.match-score.loss { color: #3dae6a; }
.match-score.draw { color: #e7c581; }
