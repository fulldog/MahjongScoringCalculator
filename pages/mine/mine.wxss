.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 12rpx 0 calc(140rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 18% 80rpx, rgba(198, 151, 75, 0.18), rgba(198, 151, 75, 0) 280rpx),
    linear-gradient(180deg, #070705 0%, #0d0b08 48%, #050504 100%);
  color: #ead7ae;
}

.shell {
  width: 100%;
  max-width: 430px;
  margin: 0 auto;
}

.profile {
  margin: 28rpx 28rpx 0;
  padding: 48rpx 28rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(42, 32, 18, 0.72), rgba(16, 13, 9, 0.94));
  border: 1rpx solid rgba(205, 151, 73, 0.32);
}

.ring {
  padding: 6rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #f6d27e, #8a5a28);
}

.avatar {
  width: 148rpx;
  height: 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1a140e;
  color: #e7c581;
  font-size: 56rpx;
  font-weight: 700;
}

.name {
  margin-top: 22rpx;
  color: #efd7a4;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.status {
  margin-top: 14rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(231, 197, 129, 0.12);
  border: 1rpx solid rgba(231, 197, 129, 0.35);
  color: #e7c581;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.rows {
  margin: 24rpx 28rpx 0;
  padding: 8rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(16, 13, 9, 0.72);
  border: 1rpx solid rgba(205, 151, 73, 0.22);
}

.row {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
}

.row + .row {
  border-top: 1rpx solid rgba(205, 151, 73, 0.16);
}

.row-mark {
  width: 8rpx;
  height: 36rpx;
  margin-right: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #f6d27e, #c98936);
}

.row-title {
  color: #efd7a4;
  font-size: 28rpx;
  font-weight: 600;
}

.row-desc {
  margin-top: 4rpx;
  color: rgba(232, 211, 171, 0.5);
  font-size: 22rpx;
}

.logout {
  margin: 28rpx 28rpx 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  border: 1rpx solid rgba(226, 91, 75, 0.45);
  color: #e7a097;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
