.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 50% 80rpx, rgba(198, 151, 75, 0.14), rgba(198, 151, 75, 0) 240rpx),
    linear-gradient(180deg, #070705 0%, #0d0b08 58%, #050504 100%);
  color: #ead7ae;
}

.intro-title {
  color: #efd7a4;
  font-size: 40rpx;
  font-weight: 700;
}

.intro-desc,
.hint,
.rules,
.seat-count,
.empty {
  color: rgba(232, 211, 171, 0.72);
  font-size: 26rpx;
  line-height: 40rpx;
}

.intro-desc,
.seat-count {
  margin-top: 12rpx;
}

.seat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 28rpx;
}

.seat-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 28rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(12, 12, 9, 0.96);
  border: 1rpx solid rgba(199, 154, 87, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.seat-card.is-on {
  border-color: rgba(214, 166, 88, 0.72);
}

.seat-card-hover {
  background: rgba(28, 24, 16, 0.98);
}

.seat-badge {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(180deg, #3f3320 0%, #22180d 100%);
  border: 1rpx solid rgba(214, 166, 88, 0.62);
  color: #efd7a4;
  font-size: 34rpx;
  font-weight: 700;
}

.seat-card.is-on .seat-badge {
  background: linear-gradient(180deg, #f6d27e 0%, #c98936 100%);
  color: #201005;
}

.seat-label {
  margin-top: 14rpx;
  color: rgba(232, 211, 171, 0.62);
  font-size: 24rpx;
}

.seat-name {
  margin-top: 6rpx;
  max-width: 100%;
  color: #efd7a4;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.seat-hint {
  margin-top: 8rpx;
  color: rgba(232, 211, 171, 0.48);
  font-size: 22rpx;
}

.score-strip {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.score-chip {
  flex: 1;
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(12, 12, 9, 0.96);
  border: 1rpx solid rgba(199, 154, 87, 0.32);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-name,
.score-delta {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 20rpx;
  color: rgba(232, 211, 171, 0.66);
}

.score-value {
  margin-top: 4rpx;
  color: #efd09a;
  font-size: 32rpx;
  font-weight: 700;
}

.num-pos {
  color: #3dcc7a;
}

.num-neg {
  color: #ef5b5b;
}

.report-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.progress {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.progress-item {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(199, 154, 87, 0.28);
  color: rgba(232, 211, 171, 0.55);
  font-size: 24rpx;
}

.progress-item.is-done {
  color: #efd7a4;
  border-color: rgba(214, 166, 88, 0.5);
}

.progress-item.is-current {
  background: linear-gradient(180deg, #f6d27e 0%, #c98936 100%);
  border-color: transparent;
  color: #201005;
  font-weight: 700;
}

.block {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(12, 12, 9, 0.96);
  border: 1rpx solid rgba(199, 154, 87, 0.32);
}

.block-title,
.sub-title,
.step-label {
  color: #efd7a4;
  font-size: 28rpx;
  font-weight: 700;
}

.sub-title {
  margin-top: 22rpx;
}

.choices {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.choice,
.minor,
.ghost,
.danger,
.primary,
.step-btn,
.switch {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.choice,
.minor {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: rgba(23, 21, 16, 0.94);
  border: 1rpx solid rgba(199, 154, 87, 0.32);
  color: #e8d3ab;
  font-size: 26rpx;
}

.choice.is-on {
  background: linear-gradient(180deg, #f6d27e 0%, #c98936 100%);
  border-color: rgba(255, 229, 159, 0.72);
  color: #201005;
  font-weight: 700;
}

.hint,
.rules {
  margin-top: 16rpx;
}

.switch-row,
.step-row,
.dian-row,
.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.switch-row,
.step-row,
.dian-row {
  margin-top: 18rpx;
}

.step-note {
  margin-top: 4rpx;
  color: rgba(232, 211, 171, 0.5);
  font-size: 22rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.step-btn,
.switch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #3f3320 0%, #22180d 100%);
  border: 1rpx solid rgba(214, 166, 88, 0.62);
  color: #efd7a4;
  font-size: 32rpx;
  font-weight: 700;
}

.switch {
  width: 72rpx;
  font-size: 24rpx;
}

.switch.is-on {
  background: linear-gradient(180deg, #f6d27e 0%, #c98936 100%);
  color: #201005;
}

.step-value {
  min-width: 48rpx;
  text-align: center;
  color: #efd7a4;
  font-size: 32rpx;
  font-weight: 700;
}

.inline-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.minor {
  flex: 1;
}

.text-link,
.footer-reset {
  color: #e7c581;
  font-size: 26rpx;
  font-weight: 700;
}

.footer-reset {
  margin-top: 18rpx;
  text-align: center;
}

.history-list {
  margin-top: 22rpx;
}

.history-card {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(12, 12, 9, 0.96);
  border: 1rpx solid rgba(199, 154, 87, 0.32);
}

.history-round {
  color: #efd7a4;
  font-size: 28rpx;
  font-weight: 700;
}

.history-line {
  margin-top: 8rpx;
  color: #e8d3ab;
  font-size: 26rpx;
  line-height: 38rpx;
  word-break: break-all;
}

.empty {
  margin-top: 40rpx;
  text-align: center;
}

.footer {
  margin-top: 28rpx;
}

.primary,
.ghost,
.danger {
  height: 84rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.primary {
  background: linear-gradient(180deg, #f6d27e 0%, #c98936 100%);
  color: #201005;
}

.primary.is-disabled,
.ghost.is-disabled {
  opacity: 0.4;
}

.ghost {
  flex: 1;
  background: linear-gradient(180deg, #3f3320 0%, #22180d 100%);
  border: 1rpx solid rgba(214, 166, 88, 0.62);
  color: #efd7a4;
}

.danger {
  flex: 1;
  background: linear-gradient(180deg, #b44837 0%, #7f2119 100%);
  color: #fff0dc;
}

.footer-row {
  margin-top: 16rpx;
}

.footer-grow {
  flex: 1.4;
}
