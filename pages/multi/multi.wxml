<view class="page">
  <view wx:if="{{needHostLogin}}" class="gate">
    <view class="gate-title">登录后开房</view>
    <view class="gate-desc">多人牌局需要授权登录才能入座。游客可以通过别人的分享进入房间观战、发弹幕。</view>
    <view class="primary" bindtap="goLogin">去登录</view>
  </view>

  <block wx:else>
    <view class="table-wrap">
      <view class="table-bar">
        <text class="room-code">房间 {{code}}</text>
        <view class="online-btn" bindtap="toggleOnline">{{online.length}} 在线</view>
      </view>
      <view wx:if="{{onlineOpen}}" class="online-panel">
        <view wx:for="{{online}}" wx:key="key" class="online-item">{{item.nickname}}</view>
        <view wx:if="{{online.length === 0}}" class="online-item">还没有人</view>
      </view>
      <view class="table">
        <view class="danmaku-layer">
          <view wx:for="{{flying}}" wx:key="id" class="fly" style="top: {{item.top}}rpx;">{{item.text}}</view>
        </view>
        <view
          wx:for="{{seats}}"
          wx:key="key"
          class="seat seat-{{item.key}} {{item.mine ? 'is-mine' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSeatTap"
        >
          <view class="seat-score {{item.tone}}">{{item.scoreText}}</view>
          <view class="avatar">
            <image wx:if="{{item.avatarUrl}}" class="avatar-img" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <text wx:else>{{item.initial}}</text>
          </view>
          <view class="seat-name">{{item.nameText}}</view>
          <view class="seat-meta">{{item.label}}<text wx:if="{{item.submitted}}"> · 已交</text></view>
        </view>
        <view class="table-center">
          <view class="table-round" wx:if="{{status === 'playing'}}">第 {{roundNo}} 把</view>
          <view class="table-round" wx:elif="{{status === 'ended'}}">已结束</view>
          <view class="table-round" wx:else>未开局</view>
        </view>
      </view>
    </view>

    <scroll-view class="sheet" scroll-y>
      <view wx:if="{{settleError}}" class="banner">{{settleError}}</view>

      <view wx:if="{{status === 'waiting'}}" class="block">
        <view class="block-title">入座后开局</view>
        <view class="hint">登录用户点空位入座。房主必须入座，两人及以上才能开始。分享后朋友用同一房间进入。</view>
        <button class="share" open-type="share">分享房间</button>
        <view wx:if="{{you.host}}" class="primary" bindtap="startGame">开始对局</view>
        <view wx:elif="{{!loggedIn}}" class="primary" bindtap="goLogin">登录后入座</view>
      </view>

      <view wx:if="{{showForm}}" class="block">
        <view class="block-title">第 {{roundNo}} 把 · 填写自己的成绩</view>
        <view class="choices">
          <view
            wx:for="{{outcomes}}"
            wx:key="key"
            class="choice {{draft.outcome === item.key ? 'is-on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onOutcome"
          >{{item.label}}</view>
        </view>
        <view class="hint">有人胡牌时，其余人选未胡走局或放炮。流局时，所有人都选黄庄有叫或黄庄无叫。</view>
      </view>

      <view wx:if="{{showForm && needOpponent}}" class="block">
        <view class="block-title">{{opponentTitle}}</view>
        <view class="choices">
          <view
            wx:for="{{opponents}}"
            wx:key="id"
            class="choice {{draft.opponentId === item.id ? 'is-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onOpponent"
          >{{item.title}}</view>
        </view>
      </view>

      <view wx:if="{{showForm}}" class="block">
        <view class="block-title">叫口</view>
        <view wx:if="{{jiaoMode === 'yes'}}" class="hint">记为有叫，可以捉鸡，豆照常计。</view>
        <view wx:elif="{{jiaoMode === 'no'}}" class="hint">记为无叫。黄庄时豆不计，并向每家有叫赔查叫。</view>
        <view wx:else class="switch-row" bindtap="onToggleJiao">
          <text>有叫（听牌）</text>
          <view class="switch {{draft.hasJiao ? 'is-on' : ''}}">{{draft.hasJiao ? '有' : '无'}}</view>
        </view>
      </view>

      <view wx:if="{{showForm}}" class="block">
        <view class="block-title">豆</view>
        <view class="step-row">
          <view>
            <view class="step-label">闷豆</view>
            <view class="step-note">每家 {{scoreRule.menDou}}</view>
          </view>
          <view class="stepper">
            <view class="step-btn" data-field="menDou" data-delta="-1" bindtap="onStep">-</view>
            <text class="step-value">{{draft.menDou}}</text>
            <view class="step-btn" data-field="menDou" data-delta="1" bindtap="onStep">+</view>
          </view>
        </view>
        <view class="step-row">
          <view>
            <view class="step-label">爬坡豆</view>
            <view class="step-note">每家 {{scoreRule.papoDou}}</view>
          </view>
          <view class="stepper">
            <view class="step-btn" data-field="papoDou" data-delta="-1" bindtap="onStep">-</view>
            <text class="step-value">{{draft.papoDou}}</text>
            <view class="step-btn" data-field="papoDou" data-delta="1" bindtap="onStep">+</view>
          </view>
        </view>
        <view class="sub-title">点豆 · 每笔 {{scoreRule.dianDou}}</view>
        <view class="choices">
          <view
            wx:for="{{opponents}}"
            wx:key="id"
            class="choice {{dianOpponentId === item.id ? 'is-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onPickDian"
          >{{item.title}}</view>
        </view>
        <view class="inline-actions">
          <view class="minor" data-direction="gang" bindtap="onAddDian">杠了对方</view>
          <view class="minor" data-direction="bei" bindtap="onAddDian">被对方杠</view>
        </view>
        <view wx:if="{{dianRows.length === 0}}" class="hint">还没有点豆</view>
        <view wx:for="{{dianRows}}" wx:key="index" class="dian-row">
          <text>{{item.text}}</text>
          <text class="text-link" data-index="{{item.index}}" bindtap="onRemoveDian">删除</text>
        </view>
      </view>

      <view wx:if="{{showForm}}" class="block">
        <view class="block-title">鸡</view>
        <view class="switch-row" data-field="chongfeng" bindtap="onFlag">
          <text>冲锋鸡 · {{scoreRule.chongfeng}}</text>
          <view class="switch {{draft.chongfeng ? 'is-on' : ''}}">{{draft.chongfeng ? '有' : '无'}}</view>
        </view>
        <view class="step-row">
          <view>
            <view class="step-label">鸡数</view>
            <view class="step-note">每只 {{scoreRule.chicken}}</view>
          </view>
          <view class="stepper">
            <view class="step-btn" data-field="chickenCount" data-delta="-1" bindtap="onStep">-</view>
            <text class="step-value">{{draft.chickenCount}}</text>
            <view class="step-btn" data-field="chickenCount" data-delta="1" bindtap="onStep">+</view>
          </view>
        </view>
        <view class="switch-row" data-field="golden" bindtap="onFlag">
          <text>金鸡 · 鸡分再 ×{{scoreRule.goldenMultiplier}}</text>
          <view class="switch {{draft.golden ? 'is-on' : ''}}">{{draft.golden ? '是' : '否'}}</view>
        </view>
      </view>

      <view wx:if="{{showForm}}" class="primary" bindtap="submitReport">{{you.submitted ? '修改并提交' : '提交本把'}}</view>
      <view wx:if="{{status === 'playing' && roundStatus === 'reporting' && you.submitted && !showForm}}" class="hint wait">已提交，等待其他入座玩家。</view>
      <view wx:if="{{status === 'playing' && !you.seat}}" class="hint wait">你在观战，入座玩家提交后会看到结算。</view>

      <view wx:if="{{status === 'playing' && roundStatus === 'settled'}}" class="block">
        <view class="block-title">这一把已结算</view>
        <view wx:if="{{you.host}}" class="primary" bindtap="nextRound">下一把</view>
      </view>

      <view wx:if="{{you.host && status === 'playing'}}" class="ghost" bindtap="endMatch">结束牌局</view>

      <view wx:if="{{history.length}}" class="block">
        <view class="block-title">已结算</view>
        <view wx:for="{{history}}" wx:key="roundNo" class="history-card">
          <view class="history-round">第 {{item.roundNo}} 把</view>
          <view wx:for="{{item.lines}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="lineIndex" class="history-line">{{line}}</view>
        </view>
      </view>

      <view class="danmaku-bar">
        <input class="danmaku-input" placeholder="发一条弹幕" placeholder-class="ph" value="{{danmakuText}}" bindinput="onDanmakuInput" confirm-type="send" bindconfirm="sendDanmaku" />
        <view class="danmaku-send {{danmakuWait ? 'is-wait' : ''}}" bindtap="sendDanmaku">{{danmakuWait ? danmakuWait + 's' : '发送'}}</view>
      </view>
    </scroll-view>
  </block>
</view>
