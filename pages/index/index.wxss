.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eaf4ec 0%, #f7f8f4 100%);
}

.score-panel {
  position: relative;
  height: 50vh;
  min-height: 620rpx;
  margin: 24rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at center, rgba(255, 255, 255, 0.92) 0, rgba(255, 255, 255, 0.52) 28%, rgba(28, 117, 78, 0.96) 29%),
    linear-gradient(135deg, #2f9467, #14573e);
  box-shadow: 0 20rpx 48rpx rgba(20, 87, 62, 0.22);
  overflow: hidden;
}

.score-panel::after {
  content: "";
  position: absolute;
  inset: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  pointer-events: none;
}

.center-score {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.16);
}

.center-label {
  color: #5c6b61;
  font-size: 24rpx;
}

.center-value {
  margin-top: 10rpx;
  color: #14573e;
  font-size: 54rpx;
  font-weight: 700;
}

.player-card {
  position: absolute;
  z-index: 3;
  width: 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.north {
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%);
}

.south {
  bottom: 80rpx;
  left: 50%;
  transform: translateX(-50%);
}

.west {
  top: 50%;
  left: 42rpx;
  transform: translateY(-50%);
}

.east {
  top: 50%;
  right: 42rpx;
  transform: translateY(-50%);
}

.player-score {
  box-sizing: border-box;
  width: 112rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #14573e;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.avatar-circle {
  box-sizing: border-box;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 112rpx;
  min-height: 112rpx;
  max-height: 112rpx;
  margin-top: 10rpx;
  padding: 0;
  border-radius: 50%;
  display: flex;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
  overflow: hidden;
}

.south .avatar-circle {
  margin-top: 0;
}

.avatar-placeholder {
  background: linear-gradient(135deg, #fff5d8, #f2c15b);
  color: #6d4111;
}

.avatar-picker {
  color: #ffffff;
  padding: 0;
  min-width: 112rpx;
  max-width: 112rpx;
  min-height: 112rpx;
  max-height: 112rpx;
  line-height: 1;
  background: linear-gradient(135deg, #d9f1ff, #4fa4e8);
  border: 4rpx solid rgba(255, 255, 255, 0.85);
}

.avatar-picker::after {
  border: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.score-input {
  box-sizing: border-box;
  width: 132rpx;
  height: 50rpx;
  margin-top: 10rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #1f2d25;
  font-size: 26rpx;
  text-align: center;
}

.input-placeholder {
  color: #9aa59f;
}

.submit-button {
  position: absolute;
  right: 86rpx;
  bottom: 84rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 64rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #f5b642;
  color: #4a2b05;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.18);
}

.submit-button::after {
  border: 0;
}

.history-panel {
  position: relative;
  flex: 1;
  min-height: 0;
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 36rpx rgba(34, 53, 42, 0.1);
}

.history-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #1f2d25;
  font-size: 34rpx;
  font-weight: 700;
}

.round-tip {
  color: #69776f;
  font-size: 24rpx;
  font-weight: 400;
}

.empty-history {
  margin-top: 96rpx;
  color: #89938d;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.history-list {
  height: calc(50vh - 170rpx);
  margin-top: 22rpx;
  padding-bottom: 92rpx;
}

.history-item {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f3f7f1;
  color: #26382f;
  font-size: 28rpx;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reset-button {
  position: absolute;
  left: 50%;
  bottom: 28rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #d64545;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 10rpx 24rpx rgba(31, 45, 37, 0.18);
}

.reset-button::after {
  border: 0;
}
