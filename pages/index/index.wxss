.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 56rpx 24rpx 32rpx;
  background:
    radial-gradient(circle at 50% 130rpx, rgba(198, 151, 75, 0.16), rgba(198, 151, 75, 0) 260rpx),
    linear-gradient(180deg, #070705 0%, #0d0b08 52%, #050504 100%);
  color: #ead7ae;
}

.main-board {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.page.is-portrait .score-stage {
  order: 1;
}

.page.is-portrait .history-panel {
  order: 2;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 22rpx;
}

.hero-logo {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 35% 25%, rgba(218, 165, 86, 0.72), rgba(139, 80, 33, 0.44) 44%, rgba(38, 22, 12, 0.98) 100%),
    linear-gradient(145deg, #7c3d1b, #1a120d);
  border: 2rpx solid rgba(205, 151, 73, 0.58);
  color: #e7c581;
  font-size: 50rpx;
  font-weight: 700;
  box-shadow:
    0 0 24rpx rgba(190, 126, 49, 0.22),
    inset 0 0 16rpx rgba(221, 166, 86, 0.18);
}

.hero-title {
  margin-top: 20rpx;
  color: #efd7a4;
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 14rpx;
  text-indent: 14rpx;
  text-shadow: 0 0 18rpx rgba(233, 190, 116, 0.26);
}

.hero-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.divider-line {
  width: 92rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(184, 139, 73, 0), rgba(184, 139, 73, 0.82));
}

.divider-line:last-child {
  background: linear-gradient(90deg, rgba(184, 139, 73, 0.82), rgba(184, 139, 73, 0));
}

.divider-dot {
  width: 12rpx;
  height: 12rpx;
  transform: rotate(45deg);
  background: #b88b49;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: rgba(232, 211, 171, 0.58);
  font-size: 24rpx;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
}

.score-panel {
  position: relative;
  height: 49vh;
  min-height: 620rpx;
  margin: 0;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at center, rgba(232, 206, 151, 0.2) 0, rgba(232, 206, 151, 0.12) 140rpx, rgba(5, 5, 4, 0) 142rpx),
    linear-gradient(180deg, rgba(21, 20, 15, 0.96), rgba(8, 9, 7, 0.98));
  border: 2rpx solid rgba(199, 154, 87, 0.48);
  box-shadow:
    0 20rpx 44rpx rgba(0, 0, 0, 0.46),
    inset 0 0 0 2rpx rgba(255, 229, 163, 0.05);
  overflow: hidden;
}

.score-panel::after {
  content: "";
  position: absolute;
  inset: 22rpx;
  border: 1rpx solid rgba(199, 154, 87, 0.28);
  border-radius: 18rpx;
  pointer-events: none;
}

.center-score {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 210rpx;
  height: 210rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background:
    radial-gradient(circle at 38% 24%, rgba(214, 167, 91, 0.78), rgba(143, 83, 36, 0.9) 50%, rgba(42, 24, 13, 0.98) 100%);
  border: 3rpx solid rgba(204, 148, 73, 0.62);
  box-shadow:
    0 0 24rpx rgba(174, 112, 45, 0.24),
    0 16rpx 34rpx rgba(0, 0, 0, 0.38),
    inset 0 0 22rpx rgba(213, 155, 80, 0.16);
}

.center-label {
  color: rgba(255, 239, 199, 0.78);
  font-size: 24rpx;
}

.center-value {
  margin-top: 10rpx;
  color: #efd09a;
  font-size: 58rpx;
  font-weight: 700;
  text-shadow: 0 0 10rpx rgba(214, 145, 60, 0.26);
}

.num-pos {
  color: #3dcc7a !important;
  text-shadow: 0 0 10rpx rgba(61, 204, 122, 0.22);
}

.num-neg {
  color: #ef5b5b !important;
  text-shadow: 0 0 10rpx rgba(239, 91, 91, 0.22);
}

.player-card {
  position: absolute;
  z-index: 3;
  width: 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform-origin: center center;
}

.player-card.dragging {
  z-index: 9;
  opacity: 0.96;
  filter: drop-shadow(0 22rpx 28rpx rgba(0, 0, 0, 0.48));
  transition: transform 120ms ease, filter 120ms ease;
}

.player-card.dragging .avatar-circle {
  border-color: rgba(255, 217, 132, 0.95);
  box-shadow:
    0 0 0 8rpx rgba(218, 157, 65, 0.12),
    0 0 34rpx rgba(218, 157, 65, 0.46),
    0 18rpx 30rpx rgba(0, 0, 0, 0.48),
    inset 0 0 18rpx rgba(255, 229, 157, 0.22);
}

.player-card.dragging .player-score,
.player-card.dragging .score-input {
  border-color: rgba(255, 217, 132, 0.82);
  box-shadow: 0 0 18rpx rgba(218, 157, 65, 0.26);
}

.player-card.drop-target {
  z-index: 4;
}

.player-card.drop-target .avatar-circle {
  border-color: rgba(255, 217, 132, 0.98);
  box-shadow:
    0 0 0 10rpx rgba(218, 157, 65, 0.18),
    0 0 30rpx rgba(218, 157, 65, 0.42),
    inset 0 0 20rpx rgba(255, 229, 157, 0.2);
}

.player-card.drop-target .player-score,
.player-card.drop-target .score-input {
  border-color: rgba(255, 217, 132, 0.9);
  background: rgba(44, 31, 16, 0.96);
  box-shadow: 0 0 20rpx rgba(218, 157, 65, 0.28);
}

.north {
  top: 44rpx;
  left: 50%;
  transform: translateX(-50%);
}

.south {
  bottom: 64rpx;
  left: 50%;
  transform: translateX(-50%);
}

.west {
  top: 50%;
  left: 40rpx;
  transform: translateY(-50%);
}

.east {
  top: 50%;
  right: 40rpx;
  transform: translateY(-50%);
}

.player-score {
  box-sizing: border-box;
  width: 116rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 13, 9, 0.92);
  border: 1rpx solid rgba(218, 174, 103, 0.55);
  color: #f2d595;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
  box-shadow: inset 0 0 14rpx rgba(226, 176, 91, 0.1);
}

.avatar-circle {
  box-sizing: border-box;
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  height: 108rpx;
  min-height: 108rpx;
  max-height: 108rpx;
  margin-top: 10rpx;
  padding: 0;
  border-radius: 26rpx;
  display: flex;
  flex: 0 0 108rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(242, 197, 115, 0.68);
  box-shadow:
    0 10rpx 24rpx rgba(0, 0, 0, 0.36),
    inset 0 0 18rpx rgba(255, 229, 157, 0.14);
  overflow: hidden;
}

.south .avatar-circle {
  margin-top: 10rpx;
}

.score-input-me {
  margin-top: 0;
  margin-bottom: 0;
}

.avatar-placeholder {
  background:
    radial-gradient(circle at 34% 22%, #d8a75e, #a86129 50%, #321a0d 100%);
  color: #1f1007;
}

.avatar-picker {
  color: #e7c581;
  padding: 0;
  min-width: 108rpx;
  max-width: 108rpx;
  min-height: 108rpx;
  max-height: 108rpx;
  line-height: 1;
  background:
    radial-gradient(circle at 34% 22%, #c69555, #8f4524 50%, #21100b 100%);
}

.avatar-picker::after {
  border: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.avatar-name {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 10rpx 8rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: 1;
}

.avatar-name-first {
  flex: 0 0 auto;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.avatar-name-rest {
  flex: 0 0 auto;
  max-width: 100%;
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
  text-align: center;
}

.score-input {
  box-sizing: border-box;
  width: 126rpx;
  height: 46rpx;
  margin-top: 10rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: rgba(6, 6, 5, 0.9);
  border: 1rpx solid rgba(197, 151, 82, 0.56);
  color: #f0d297;
  font-size: 24rpx;
  text-align: center;
}

.input-placeholder {
  color: rgba(236, 213, 168, 0.45);
}

.orientation-button {
  position: absolute;
  left: 42rpx;
  top: 54rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 72rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #3f3320 0%, #22180d 100%);
  border: 1rpx solid rgba(214, 166, 88, 0.72);
  color: #efd7a4;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow:
    0 0 18rpx rgba(211, 143, 52, 0.18),
    inset 0 0 12rpx rgba(255, 229, 157, 0.12);
}

.help-button {
  position: absolute;
  right: 42rpx;
  top: 54rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #3f3320 0%, #22180d 100%);
  border: 1rpx solid rgba(214, 166, 88, 0.72);
  color: #efd7a4;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow:
    0 0 18rpx rgba(211, 143, 52, 0.18),
    inset 0 0 12rpx rgba(255, 229, 157, 0.12);
}

.submit-button {
  position: absolute;
  right: 42rpx;
  bottom: 54rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 118rpx;
  height: 52rpx;
  margin: 0;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #f6d27e 0%, #c98936 100%);
  border: 1rpx solid rgba(255, 229, 159, 0.72);
  color: #201005;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow:
    0 0 22rpx rgba(211, 143, 52, 0.28),
    inset 0 2rpx 0 rgba(255, 243, 198, 0.36);
}

.help-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  background: rgba(0, 0, 0, 0.62);
  box-sizing: border-box;
}

.help-modal {
  width: 100%;
  max-width: 640rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(28, 24, 16, 0.98), rgba(12, 11, 8, 0.98));
  border: 2rpx solid rgba(199, 154, 87, 0.55);
  box-shadow:
    0 24rpx 48rpx rgba(0, 0, 0, 0.5),
    inset 0 0 0 1rpx rgba(255, 232, 169, 0.06);
  overflow: hidden;
  box-sizing: border-box;
}

.help-modal-header {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 72rpx 20rpx;
  border-bottom: 1rpx solid rgba(199, 154, 87, 0.28);
}

.help-modal-title {
  color: #efd7a4;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
}

.help-close {
  position: absolute;
  right: 20rpx;
  top: 18rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(232, 211, 171, 0.72);
  font-size: 44rpx;
  line-height: 1;
}

.help-modal-body {
  flex: 1;
  height: 0;
  min-height: 120rpx;
  max-height: 48vh;
  padding: 28rpx 36rpx 16rpx;
  box-sizing: border-box;
}

.help-item {
  margin-bottom: 18rpx;
  color: #e8d3ab;
  font-size: 27rpx;
  line-height: 40rpx;
}

.help-item:last-child {
  margin-bottom: 0;
}

.help-modal-footer {
  flex-shrink: 0;
  margin: 20rpx 36rpx 32rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #f6d27e 0%, #c98936 100%);
  border: 1rpx solid rgba(255, 229, 159, 0.72);
  color: #201005;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow:
    0 0 18rpx rgba(211, 143, 52, 0.22),
    inset 0 2rpx 0 rgba(255, 243, 198, 0.36);
}

.history-panel {
  position: relative;
  flex: 1;
  min-height: 0;
  margin: 22rpx 0 0;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(12, 12, 9, 0.96);
  border: 1rpx solid rgba(199, 154, 87, 0.42);
  box-shadow:
    0 18rpx 36rpx rgba(0, 0, 0, 0.36),
    inset 0 0 0 1rpx rgba(255, 232, 169, 0.04);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.history-title {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #efd7a4;
  font-size: 34rpx;
  font-weight: 700;
}

.round-tip {
  color: rgba(232, 211, 171, 0.62);
  font-size: 24rpx;
  font-weight: 400;
}

.history-body {
  flex: 1;
  min-height: 0;
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.empty-history {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(232, 211, 171, 0.48);
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.history-list {
  flex: 1;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.history-item {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(23, 21, 16, 0.94);
  border: 1rpx solid rgba(199, 154, 87, 0.26);
  color: #e8d3ab;
  font-size: 27rpx;
  line-height: 38rpx;
  overflow: visible;
  white-space: normal;
  word-break: break-all;
}

.history-text {
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  word-break: break-all;
}

.history-actions {
  flex-shrink: 0;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.undo-button,
.reset-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  height: 68rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.undo-button {
  background: linear-gradient(180deg, #3f3320 0%, #22180d 100%);
  border: 1rpx solid rgba(214, 166, 88, 0.62);
  color: #efd7a4;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.28);
}

.reset-button {
  height: 68rpx;
  background: linear-gradient(180deg, #b44837 0%, #7f2119 100%);
  border: 1rpx solid rgba(252, 177, 131, 0.46);
  color: #fff0dc;
  box-shadow: 0 12rpx 24rpx rgba(127, 33, 25, 0.32);
}

.undo-button::after,
.reset-button::after {
  border: 0;
}

/* ========== Landscape layout ========== */
.page.is-landscape {
  height: var(--ls-page-h, 100vh);
  max-height: var(--ls-page-h, 100vh);
  overflow: hidden;
  padding: var(--ls-pad-top, 6px) var(--ls-pad-right, 6px) var(--ls-pad-bottom, 6px)
    var(--ls-pad-left, 6px);
  box-sizing: border-box;
}

.page.is-portrait {
  height: auto;
  max-height: none;
  overflow: visible;
}

.page.is-landscape .avatar-picker {
  position: relative;
  z-index: 20;
}

.page.is-landscape .main-board {
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

.page.is-landscape .history-panel {
  flex: 1;
  width: 0;
  min-width: 0;
  height: var(--ls-square, 300px);
  min-height: var(--ls-square, 300px);
  max-height: var(--ls-square, 300px);
  margin: 0;
  padding: 12px;
  border-radius: 14px;
  overflow: hidden;
  box-sizing: border-box;
}

.page.is-landscape .score-stage {
  flex: none;
  width: var(--ls-square, 300px);
  height: var(--ls-square, 300px);
  min-width: var(--ls-square, 300px);
  min-height: var(--ls-square, 300px);
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  overflow: hidden;
}

.page.is-landscape .score-panel {
  flex: none;
  width: 100%;
  height: 100%;
  min-height: 0;
  border-radius: 14px;
  box-sizing: border-box;
  background:
    radial-gradient(
      circle at center,
      rgba(232, 206, 151, 0.18) 0,
      rgba(232, 206, 151, 0.1) 36%,
      rgba(5, 5, 4, 0) 38%
    ),
    linear-gradient(180deg, rgba(21, 20, 15, 0.96), rgba(8, 9, 7, 0.98));
}

.page.is-landscape .score-panel::after {
  inset: 8px;
  border-radius: 10px;
}

.page.is-landscape .center-score {
  width: var(--ls-center, 72px);
  height: var(--ls-center, 72px);
  border-width: 2px;
  box-shadow:
    0 0 12px rgba(174, 112, 45, 0.2),
    0 8px 16px rgba(0, 0, 0, 0.32),
    inset 0 0 12px rgba(213, 155, 80, 0.14);
}

.page.is-landscape .center-label {
  font-size: var(--ls-font-sm, 11px);
}

.page.is-landscape .center-value {
  margin-top: 2px;
  font-size: var(--ls-font-lg, 28px);
}

.page.is-landscape .player-card {
  width: var(--ls-card, 72px);
  top: 50%;
  left: 50%;
  right: auto;
  bottom: auto;
}

.page.is-landscape .north {
  transform: translate(-50%, -50%) translateY(var(--ls-radius-n, -90px));
}

.page.is-landscape .south {
  transform: translate(-50%, -50%) translateY(var(--ls-radius, 90px));
}

.page.is-landscape .west {
  transform: translate(-50%, -50%) translateX(var(--ls-radius-n, -90px));
}

.page.is-landscape .east {
  transform: translate(-50%, -50%) translateX(var(--ls-radius, 90px));
}

.page.is-landscape .player-card.dragging {
  transform: none;
}

.page.is-landscape .player-score {
  width: var(--ls-score-w-badge, 56px);
  height: var(--ls-score-h, 20px);
  padding: 0 4px;
  font-size: var(--ls-font, 14px);
  line-height: var(--ls-score-h, 20px);
}

.page.is-landscape .avatar-circle,
.page.is-landscape .avatar-picker {
  width: var(--ls-avatar, 44px);
  min-width: var(--ls-avatar, 44px);
  max-width: var(--ls-avatar, 44px);
  height: var(--ls-avatar, 44px);
  min-height: var(--ls-avatar, 44px);
  max-height: var(--ls-avatar, 44px);
  flex: 0 0 var(--ls-avatar, 44px);
  margin-top: 3px;
  border-radius: 10px;
  border-width: 1px;
  box-shadow:
    0 4px 10px rgba(0, 0, 0, 0.28),
    inset 0 0 8px rgba(255, 229, 157, 0.12);
}

.page.is-landscape .avatar-text,
.page.is-landscape .avatar-name-first {
  font-size: var(--ls-font, 14px);
}

.page.is-landscape .avatar-name {
  padding: 2px;
}

.page.is-landscape .avatar-name-rest {
  margin-top: 1px;
  font-size: var(--ls-font-sm, 10px);
}

.page.is-landscape .score-input {
  width: var(--ls-input-w, 62px);
  height: var(--ls-input-h, 22px);
  margin-top: 3px;
  padding: 0 4px;
  font-size: var(--ls-font-sm, 11px);
  border-radius: 6px;
}

.page.is-landscape .orientation-button {
  top: var(--ls-inset, 18px);
  left: var(--ls-inset, 18px);
  right: auto;
  min-width: var(--ls-orient-w, 60px);
  height: var(--ls-btn-h, 30px);
  padding: 0 8px;
  border-radius: 999px;
  font-size: var(--ls-font-sm, 12px);
}

.page.is-landscape .help-button {
  top: var(--ls-inset, 18px);
  left: var(--ls-help-left, 86px);
  right: auto;
  width: var(--ls-btn-h, 30px);
  height: var(--ls-btn-h, 30px);
  font-size: var(--ls-font, 14px);
}

.page.is-landscape .submit-button {
  right: var(--ls-inset, 18px);
  bottom: var(--ls-inset, 18px);
  width: var(--ls-submit-w, 66px);
  height: var(--ls-btn-h, 30px);
  font-size: var(--ls-font-sm, 12px);
  border-radius: 8px;
}

.page.is-landscape .history-title {
  font-size: 15px;
}

.page.is-landscape .round-tip {
  font-size: 11px;
}

.page.is-landscape .history-body {
  margin-top: 8px;
}

.page.is-landscape .history-item {
  margin-bottom: 6px;
  padding: 8px 10px;
  border-radius: 8px;
  font-size: 12px;
  line-height: 18px;
}

.page.is-landscape .history-actions {
  margin-top: 8px;
  gap: 6px;
}

.page.is-landscape .undo-button,
.page.is-landscape .reset-button {
  height: 34px;
  font-size: 12px;
  border-radius: 8px;
}

.page.is-landscape .empty-history {
  font-size: 12px;
  line-height: 18px;
  padding: 0 8px;
}

.page.is-landscape .help-mask {
  padding: 12px 24px;
}

.page.is-landscape .help-modal {
  width: min(560px, 72vw);
  max-width: 72vw;
  max-height: 86vh;
  border-radius: 14px;
}

.page.is-landscape .help-modal-header {
  padding: 12px 40px 10px;
}

.page.is-landscape .help-modal-title {
  font-size: 16px;
  letter-spacing: 2px;
  text-indent: 2px;
}

.page.is-landscape .help-close {
  right: 8px;
  top: 6px;
  width: 32px;
  height: 32px;
  font-size: 24px;
}

.page.is-landscape .help-modal-body {
  max-height: none;
  padding: 10px 16px 6px;
}

.page.is-landscape .help-item {
  margin-bottom: 8px;
  font-size: 13px;
  line-height: 20px;
}

.page.is-landscape .help-modal-footer {
  margin: 8px 16px 12px;
  height: 36px;
  font-size: 13px;
  border-radius: 8px;
}
