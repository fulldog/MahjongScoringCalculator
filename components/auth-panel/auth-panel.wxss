.panel {
  padding: 28rpx 28rpx 12rpx;
}

.head {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx 8rpx;
}

.mark {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 35% 25%, rgba(218, 165, 86, 0.72), rgba(139, 80, 33, 0.44) 44%, rgba(38, 22, 12, 0.98) 100%);
  border: 2rpx solid rgba(205, 151, 73, 0.58);
  color: #e7c581;
  font-size: 42rpx;
  font-weight: 700;
  box-shadow: inset 0 0 16rpx rgba(221, 166, 86, 0.18);
}

.head-copy {
  margin-left: 20rpx;
  min-width: 0;
}

.title {
  color: #efd7a4;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.subtitle {
  margin-top: 6rpx;
  color: rgba(232, 211, 171, 0.55);
  font-size: 24rpx;
}

.sheet {
  margin-top: 28rpx;
  padding: 36rpx 28rpx 28rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(42, 32, 18, 0.72), rgba(16, 13, 9, 0.94));
  border: 1rpx solid rgba(205, 151, 73, 0.32);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
}

.avatar-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  width: 168rpx !important;
  height: 168rpx !important;
  min-width: 168rpx !important;
  max-width: 168rpx !important;
  margin: 0 auto !important;
  padding: 0 !important;
  line-height: 1 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50% !important;
  overflow: hidden;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.photo {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
}

.photo.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 38%, rgba(231, 197, 129, 0.22), rgba(28, 20, 12, 0.2) 42%, rgba(12, 9, 6, 0.96) 70%);
  border: 2rpx solid rgba(231, 197, 129, 0.55);
  box-shadow: inset 0 0 24rpx rgba(201, 137, 54, 0.18);
}

.glyph-head {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e7c581;
}

.glyph-body {
  width: 72rpx;
  height: 36rpx;
  margin-top: 10rpx;
  border-radius: 36rpx 36rpx 8rpx 8rpx;
  background: rgba(231, 197, 129, 0.86);
}

.hint {
  margin-top: 16rpx;
  color: rgba(232, 211, 171, 0.5);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.field {
  margin-top: 36rpx;
}

.label {
  margin-bottom: 12rpx;
  padding-left: 8rpx;
  color: rgba(232, 211, 171, 0.62);
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.name {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: rgba(8, 7, 5, 0.72);
  border: 1rpx solid rgba(205, 151, 73, 0.28);
  color: #fff6e4;
  font-size: 30rpx;
  line-height: 96rpx;
}

.ph {
  color: rgba(232, 211, 171, 0.32);
}

.login {
  margin-top: 28rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f8dc96 0%, #e7c581 42%, #c98936 100%);
  color: #2a1608;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 24rpx rgba(201, 137, 54, 0.28);
}

.login.is-busy {
  opacity: 0.7;
}

.note {
  margin-top: 20rpx;
  color: rgba(232, 211, 171, 0.46);
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}
